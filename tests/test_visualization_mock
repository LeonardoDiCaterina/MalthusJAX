def test_ga_visualizer(single_run_data, mock_matplotlib):
    """Test GeneticAlgorithmVisualizer methods."""
    
    # IMPORTANT: We patch the class check because we are using a Mock object,
    # not the real GeneticGenerationOutput class which might be hard to import.
    with patch('malthusjax.visualization.single_run.GeneticGenerationOutput', MockHistory):
        # The code checks `isinstance(history, GeneticGenerationOutput)`
        # Since we patched the class name to point to MockHistory, it will pass.
        
        viz = GeneticAlgorithmVisualizer(single_run_data)
        
        # 1. Test Dashboard (with genome)
        viz.create_dashboard(include_genome=True)
        
        # 2. Test Convergence Analysis
        viz.create_convergence_analysis()
        
        # 3. Test Genome Evolution
        viz.plot_genome_evolution()
        
        # 4. Test 1D Genome fallback (Edge case)
        single_run_data.best_genome = np.random.rand(10) # 1D array
        viz_1d = GeneticAlgorithmVisualizer(single_run_data)
        viz_1d.plot_genome_evolution()

def test_ga_visualizer_type_error(single_run_data):
    """Ensure it raises error if history is wrong type."""
    # We pass a raw string instead of a history object to trigger type error
