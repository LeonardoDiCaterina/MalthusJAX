.PHONY: help run-toml run-toml-trace run-toml-nohup artifacts clean-results

# Minimal Makefile for running TOML-driven Composer experiments.
# Usage examples:
#   make run-toml TOML=examples/toy_gap_convergence.toml
#   make run-toml-trace TOML=examples/toy_gap_convergence.toml TRACE=results/traces
#   make clean-results

PYTHON ?= python3
TOML ?=
RESULTS_ROOT ?= results
TRACE ?= $(RESULTS_ROOT)/traces

help:
	@echo "Makefile.experiments - small helper for TOML experiments"
	@echo "  make run-toml TOML=examples/foo.toml"
	@echo "  make run-toml-trace TOML=examples/foo.toml TRACE=results/traces"
	@echo "  make artifacts TOML=examples/foo.toml"

run-toml:
	@test -n "$(TOML)" || (echo "Error: TOML variable not set"; echo "Usage: make run-toml TOML=examples/experiment.toml"; exit 1)
	@test -f "$(TOML)" || (echo "Error: TOML file not found: $(TOML)"; exit 1)
	@echo "--- Running TOML experiment: $(TOML) ---"
	PYTHONUNBUFFERED=1 $(PYTHON) scripts/run_composer.py $(TOML)

run-toml-trace:
	@test -n "$(TOML)" || (echo "Error: TOML variable not set"; exit 1)
	@test -f "$(TOML)" || (echo "Error: TOML file not found: $(TOML)"; exit 1)
	@echo "--- Running TOML experiment with traces: $(TOML) ---"
	PYTHONUNBUFFERED=1 $(PYTHON) scripts/run_composer.py $(TOML) --trace $(TRACE) --write-artifacts

run-toml-nohup:
	@test -n "$(TOML)" || (echo "Error: TOML variable not set"; exit 1)
	@test -f "$(TOML)" || (echo "Error: TOML file not found: $(TOML)"; exit 1)
	@logfile=$$(date +%Y%m%d_%H%M%S)_run_toml_nohup.log; \
		echo "Running in background -> $$logfile"; \
		nohup PYTHONUNBUFFERED=1 $(PYTHON) scripts/run_composer.py $(TOML) --trace $(TRACE) --write-artifacts > $$logfile 2>&1 &

artifacts:
	@test -n "$(TOML)" || (echo "Error: TOML variable not set"; exit 1)
	@test -f "$(TOML)" || (echo "Error: TOML file not found: $(TOML)"; exit 1)
	@echo "--- Writing artifacts for TOML experiment: $(TOML) ---"
	PYTHONUNBUFFERED=1 $(PYTHON) scripts/run_composer.py $(TOML) --write-artifacts

clean-results:
	@echo "--- Cleaning $(RESULTS_ROOT) ---"
	rm -rf $(RESULTS_ROOT)/*
